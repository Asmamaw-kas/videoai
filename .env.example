# ── Telegram ──────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs of admins
# To find your ID, message @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# ── Payment accounts ──────────────────────────────────────────
CBE_ACCOUNT=1000123456789
TELEBIRR_ACCOUNT=0912345678
ACCOUNT_NAME=Abebe Kebede

# ── Database ──────────────────────────────────────────────────
# Path to the SQLite file (default: subscriptions.db in project root)
DB_PATH=subscriptions.db
